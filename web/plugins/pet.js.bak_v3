  const ACHIEVEMENTS = [
    { id: "first_feed", name: "第一次喂食", desc: "第一次喂触手吃东西", check: s => s.stats.feeds >= 1 },
    { id: "first_touch", name: "初次见面", desc: "第一次摸摸它", check: s => s.stats.touches >= 1 },
    { id: "feed_100", name: "触手控", desc: "累计喂食100次", check: s => s.stats.feeds >= 100 },
