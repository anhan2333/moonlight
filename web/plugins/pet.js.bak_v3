//   胖嘟嘟卷卷触手（尖端随心情变色）+ 七种表情（开心/好奇/害羞/
//   不安/委屈/撒娇/触手化）+ 睡觉/生气/发情/眩晕/惊吓
// 悬浮窗玩法参照 AI-Live-Overflow 原版手势系统：
//   单击反应 / 双击彩蛋 / 长按触手化 / 甩出爬回 / 2秒连击3·5·8 /
//   自言自语词池(深夜·早晨·午间·通用) / 孤独递进(偷看→吹泡泡→
//   搬东西→打瞌睡→睡着) / 心情表情驱动
// 玩法按 Daddy 的触手系统设计稿：三种喂食 / 情绪事件 / 羞耻play /
//   成就 / 便便清理水变浑 / 安念远程 [PET:...]
// ============================================================

(function () {
  "use strict";

  const PLUGIN_NAME = "Pet";
  const LS = "moonlight_pet_v2";
  const HOUR = 3600 * 1000;
  let API_BASE = "";
  let AI_NAME = "安念";

  const clamp = (v, a = 0, b = 100) => Math.max(a, Math.min(b, Number(v) || 0));
  const rand = (a, b) => a + Math.random() * (b - a);
  const randPick = (a) => a[Math.floor(Math.random() * a.length)];
  const sleep = (ms) => new Promise(r => setTimeout(r, ms));
  const esc = (s) => String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  function authJson() {
    const secret = localStorage.getItem("companion_secret") || "";
    return { "Authorization": "Bearer " + secret, "Content-Type": "application/json" };
  }
  function hhmm(ts) {
    const d = new Date(ts);
    return String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
  }
  function nextWaste(base = Date.now(), soon = false) {
    return base + rand(soon ? 0.5 * HOUR : 2.5 * HOUR, soon ? 4 * HOUR : 7 * HOUR);
  }

  // ── 情绪状态（悬浮窗表情直接由这些值驱动）──
  const MOODS = {
    happy:   { name: "开心", icon: "💕", expr: "happy",   ring: "#ffb1cd", threshold: s => s.happiness >= 70 && s.lust < 80 },
    hungry:  { name: "饿了", icon: "🍖", expr: "uneasy",  ring: "#e8a06a", threshold: s => s.fullness < 40 },
    sleepy:  { name: "困了", icon: "💤", expr: "sleep",   ring: "#a8bde8", threshold: s => s.sleepiness >= 70 },
    horny:   { name: "想要", icon: "🔥", expr: "lust",    ring: "#ff5f95", threshold: s => s.lust >= 80 },
    sad:     { name: "委屈", icon: "🥺", expr: "wronged", ring: "#b0a0d8", threshold: s => s.happiness < 30 },
    angry:   { name: "生气", icon: "😤", expr: "angry",   ring: "#e85a5a", threshold: s => s.anger >= 70 },
    normal:  { name: "乖乖", icon: "🐙", expr: "normal",  ring: "#ffa8d2", threshold: () => true },
  };

  // ── 喂食（设计稿数值）──
  const FEEDS = {
    saliva: { name: "唾液", icon: "💋", fullness: 30, mood: 20, lust: 0,  shame: 0,  desc: "亲亲触手的顶端" },
