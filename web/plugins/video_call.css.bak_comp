/* ============================================================
   视频通话插件样式 · Video Call Plugin CSS
   独立于现有语音通话样式，不改动 moonlight-ui.css 任何规则。
   ============================================================ */

/* ── 面板容器：全屏浮层 ── */
.vc-panel{
  position: fixed; inset: 0; z-index: 9500;
  display: flex; flex-direction: column;
  background: #0b0d12;
  opacity: 0; pointer-events: none;
  transform: translateY(14px);
  transition: opacity .32s ease, transform .32s ease;
}
.vc-panel:not(.hidden){ opacity: 1; pointer-events: auto; transform: translateY(0); }
.vc-panel.hidden{ display: none; }

/* ── 视频舞台 ── */
.vc-stage{
  position: relative; flex: 1 1 auto; min-height: 0;
  overflow: hidden;
  background:
    radial-gradient(120% 90% at 50% 0%, rgba(120,140,255,.12), transparent 60%),
    linear-gradient(180deg, #10131b 0%, #0b0d12 100%);
}
.vc-remote{
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 14px;
}
.vc-remote img#vcRemoteAvatar{
  width: clamp(140px, 34vw, 220px); height: clamp(140px, 34vw, 220px);
  border-radius: 50%; object-fit: cover;
  border: 2px solid rgba(255,255,255,.16);
  box-shadow: 0 0 0 10px rgba(140,160,255,.06), 0 24px 60px rgba(0,0,0,.55);
  animation: vcBreath 4.2s ease-in-out infinite;
}
@keyframes vcBreath{
  0%,100%{ transform: scale(1); box-shadow: 0 0 0 10px rgba(140,160,255,.06), 0 24px 60px rgba(0,0,0,.55); }
  50%{ transform: scale(1.025); box-shadow: 0 0 0 18px rgba(140,160,255,.10), 0 24px 60px rgba(0,0,0,.55); }
}
.vc-remote-name{
  color: #eef1ff; font-size: clamp(17px, 4.6vw, 22px);
  letter-spacing: .06em; font-weight: 600;
  text-shadow: 0 2px 12px rgba(0,0,0,.6);
}
.vc-remote-status{
  color: rgba(238,241,255,.55); font-size: 12.5px; letter-spacing: .04em;
}
.vc-remote video#vcRemoteVideo{
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; background: #000;
}
.vc-remote video#vcRemoteVideo:not(.hidden) + img#vcRemoteAvatar,
.vc-remote video#vcRemoteVideo:not(.hidden) ~ .vc-remote-name,
.vc-remote video#vcRemoteVideo:not(.hidden) ~ .vc-remote-status{ display: none; }
.vc-remote video#vcRemoteVideo.hidden{ display: none; }

/* ── 本地预览小窗（可拖动）── */
.vc-local{
  position: absolute; right: 14px; bottom: 14px;
  width: clamp(96px, 24vw, 150px); aspect-ratio: 3 / 4;
  border-radius: 14px; overflow: hidden;
  border: 1.5px solid rgba(255,255,255,.22);
  box-shadow: 0 10px 30px rgba(0,0,0,.5);
  touch-action: none; cursor: grab;
  z-index: 5;
  transition: transform .2s ease;
}
.vc-local:active{ cursor: grabbing; transform: scale(.985); }
.vc-local video{ width: 100%; height: 100%; object-fit: cover; display: block; background: #000; }
.vc-local-hint{
  position: absolute; left: 7px; bottom: 6px;
  font-size: 10.5px; color: rgba(255,255,255,.85);
  background: rgba(0,0,0,.35); padding: 1.5px 7px; border-radius: 99px;
  backdrop-filter: blur(4px);
}

/* ── 顶栏（徽标 + 计时）── */
.vc-topbar{
  position: absolute; top: max(14px, env(safe-area-inset-top)); left: 0; right: 0;
  display: flex; align-items: center; justify-content: center; gap: 12px;
  z-index: 6; pointer-events: none;
}
.vc-badge{
  font-size: 11.5px; letter-spacing: .08em;
  color: #eef1ff; background: rgba(255,255,255,.1);
  border: 1px solid rgba(255,255,255,.14);
  padding: 4px 12px; border-radius: 99px;
  backdrop-filter: blur(6px);
}
.vc-timer{
  font-variant-numeric: tabular-nums;
  font-size: 12.5px; color: rgba(238,241,255,.8);
  background: rgba(0,0,0,.3); padding: 4px 10px; border-radius: 99px;
  backdrop-filter: blur(6px);
}

/* ── 通话内聊天区（边看画面边打字）── */
.vc-chat{
  flex: 0 0 auto;
  display: flex; flex-direction: column;
  max-height: 34%;
  background: rgba(13,16,24,.92);
  border-top: 1px solid rgba(255,255,255,.08);
  backdrop-filter: blur(14px);
}
.vc-chat-log{
  flex: 1 1 auto; overflow-y: auto;
  padding: 10px 14px 4px;
  display: flex; flex-direction: column; gap: 6px;
  -webkit-overflow-scrolling: touch;
}
.vc-msg{
  max-width: 86%;
  font-size: 13.5px; line-height: 1.5;
  padding: 7px 11px; border-radius: 14px;
  word-break: break-word; white-space: pre-wrap;
}
.vc-msg-human{
  align-self: flex-end;
  background: linear-gradient(135deg, #6f8cff, #8f6fff);
  color: #fff; border-bottom-right-radius: 5px;
}
.vc-msg-ai{
  align-self: flex-start;
  background: rgba(255,255,255,.09);
  color: #eef1ff; border-bottom-left-radius: 5px;
}
.vc-msg-sys{
  align-self: center;
  color: rgba(238,241,255,.42); font-size: 11.5px;
  background: none; padding: 1px 4px;
}
.vc-chat-input-row{
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px calc(10px + env(safe-area-inset-bottom));
}
.vc-chat-input{
  flex: 1 1 auto; min-width: 0;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 99px;
  color: #eef1ff; font-size: 14px;
  padding: 9px 15px;
  outline: none;
  transition: border-color .2s ease, background .2s ease;
}
.vc-chat-input::placeholder{ color: rgba(238,241,255,.35); }
.vc-chat-input:focus{ border-color: rgba(140,160,255,.55); background: rgba(255,255,255,.11); }
.vc-chat-send{
  flex: 0 0 auto;
  width: 38px; height: 38px; border-radius: 50%;
  border: none; cursor: pointer;
  background: linear-gradient(135deg, #6f8cff, #8f6fff);
  color: #fff; font-size: 15px;
  display: flex; align-items: center; justify-content: center;
  transition: transform .15s ease, filter .2s ease;
}
.vc-chat-send:active{ transform: scale(.92); }
.vc-chat-send:hover{ filter: brightness(1.1); }

/* ── 控制条 ── */
.vc-controls{
  flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  flex-wrap: wrap;              /* 7 个按钮在窄屏自动换行，不挤出屏 */
  gap: clamp(8px, 2.4vw, 16px);
  padding: 12px 14px calc(14px + env(safe-area-inset-bottom));
  background: rgba(13,16,24,.92);
  border-top: 1px solid rgba(255,255,255,.06);
  backdrop-filter: blur(14px);
}
.vc-ctl{
  flex: 0 0 auto;
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.12);
  color: #eef1ff; cursor: pointer;
  min-width: clamp(52px, 14vw, 64px);
  padding: 9px 6px; border-radius: 16px;
  transition: transform .15s ease, background .2s ease, opacity .2s ease;
}
.vc-ctl:active{ transform: scale(.93); }
.vc-ctl .vc-ic{ font-size: 17px; line-height: 1; }
.vc-ctl .vc-lb{ font-size: 10.5px; letter-spacing: .02em; opacity: .8; white-space: nowrap; }
.vc-ctl-mic.off, .vc-ctl-cam.off{ background: rgba(255,255,255,.04); opacity: .55; }
.vc-ctl-mic.off .vc-ic::after, .vc-ctl-cam.off .vc-ic::after{ content: " ✕"; font-size: 10px; color: #ff8080; }
.vc-ctl-shot{ background: rgba(120,140,255,.14); border-color: rgba(140,160,255,.3); }
.vc-ctl-flip{ background: rgba(140,220,180,.12); border-color: rgba(140,220,180,.28); }
.vc-ctl-frame{ background: rgba(255,200,120,.10); border-color: rgba(255,200,120,.26); }
.vc-ctl-qual{ background: rgba(190,150,255,.10); border-color: rgba(190,150,255,.26); }
.vc-ctl-gift{ background: rgba(255,130,170,.14); border-color: rgba(255,130,170,.3); }
.vc-ctl-mini{ background: rgba(255,255,255,.05); }
.vc-ctl-end{
  background: linear-gradient(135deg, #ff5d6c, #ff7a5c);
  border-color: transparent;
  box-shadow: 0 6px 18px rgba(255,93,108,.35);
}

/* ── 最小化浮条 ── */
.vc-mini{
  position: fixed; right: 14px; bottom: calc(18px + env(safe-area-inset-bottom));
  z-index: 9400;
  display: flex; align-items: center; gap: 8px;
  background: rgba(13,16,24,.94);
  border: 1px solid rgba(255,255,255,.14);
  color: #eef1ff; font-size: 12.5px;
  padding: 8px 12px; border-radius: 99px;
  box-shadow: 0 10px 30px rgba(0,0,0,.45);
  cursor: pointer;
  backdrop-filter: blur(10px);
  font-variant-numeric: tabular-nums;
}
.vc-mini.hidden{ display: none; }
.vc-mini-dot{
  width: 7px; height: 7px; border-radius: 50%;
  background: #7ddc8f;
  animation: vcPulse 1.6s ease-in-out infinite;
}
@keyframes vcPulse{ 0%,100%{ opacity: 1; } 50%{ opacity: .35; } }
.vc-mini button{
  background: rgba(255,255,255,.1); border: none; color: #eef1ff;
  font-size: 11.5px; padding: 3px 10px; border-radius: 99px; cursor: pointer;
}

/* ── 桌面端优化：居中卡片式 ── */
@media (min-width: 720px){
  .vc-panel{ background: rgba(5,7,11,.86); backdrop-filter: blur(10px); }
  .vc-stage{ max-width: 860px; margin: 0 auto; width: 100%; }
  .vc-remote{ border-radius: 0 0 18px 18px; }
}

/* ============ IB 同款扩展：弹幕 / 夹帧 / 礼物 / 来电 ============ */

/* ── 弹幕层 ── */
.vc-danmaku{ position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:3; }
.vc-dm{
  position:absolute; left:100%; white-space:nowrap;
  font-size:13px; line-height:1.35; color:#fff;
  background:rgba(10,14,22,.55); border:1px solid rgba(255,255,255,.14);
  padding:4px 12px; border-radius:999px; backdrop-filter:blur(6px);
  text-shadow:0 1px 3px rgba(0,0,0,.6);
  animation: vcDmFly 7.5s linear forwards;
}
.vc-dm-ai{ border-color:rgba(255,150,190,.4); }
.vc-dm-human{ border-color:rgba(140,190,255,.4); }
.vc-dm-gift{ background:rgba(80,20,50,.65); border-color:rgba(255,140,190,.55); color:#ffd9e8; }
.vc-dm-snap{ background:rgba(20,50,40,.6); border-color:rgba(150,230,190,.45); }
@keyframes vcDmFly{
  0%{ transform:translateX(0); opacity:0; }
  4%{ opacity:1; }
  92%{ opacity:1; }
  100%{ transform:translateX(calc(-100vw - 100%)); opacity:0; }
}
.vc-dm-toggle{
  margin-left:auto; flex:0 0 auto;
  background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18);
  color:#eef1ff; font-size:10.5px; padding:4px 9px; border-radius:999px; cursor:pointer;
}
.vc-dm-toggle.off{ opacity:.5; }

/* ── 礼物统计角标 ── */
.vc-gift-badge{
  position:absolute; top:10px; right:10px; z-index:4;
  background:rgba(80,20,50,.6); border:1px solid rgba(255,140,190,.4);
  color:#ffd9e8; font-size:12px; padding:4px 10px; border-radius:999px;
  backdrop-filter:blur(6px);
}

/* ── 夹帧条 ── */
.vc-pending{
  display:flex; align-items:center; gap:8px;
  padding:8px 10px; border-bottom:1px solid rgba(255,255,255,.07);
  background:rgba(255,200,120,.05);
}
.vc-pending.hidden{ display:none; }
.vc-pending img{
  width:52px; height:40px; object-fit:cover; border-radius:8px;
  border:1px solid rgba(255,255,255,.25);
}
.vc-pending-act{
  background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.16);
  color:#eef1ff; font-size:11.5px; padding:5px 10px; border-radius:999px; cursor:pointer;
}
.vc-pending-now{ background:rgba(120,140,255,.18); border-color:rgba(140,160,255,.4); }
.vc-pending-x{
  margin-left:auto; background:none; border:none; color:#ffb0b0;
  font-size:14px; cursor:pointer; padding:4px 8px;
}

/* ── 礼物盘 ── */
.vc-gift-tray{
  position:absolute; left:0; right:0; bottom:0; z-index:30;
  display:flex; flex-wrap:wrap; align-items:center; justify-content:center;
  gap:10px; padding:14px 12px calc(16px + env(safe-area-inset-bottom));
  background:rgba(13,16,24,.96); border-top:1px solid rgba(255,140,190,.25);
  backdrop-filter:blur(16px);
  animation:vcTrayUp .22s ease;
}
@keyframes vcTrayUp{ from{ transform:translateY(100%);} to{ transform:translateY(0);} }
.vc-gift-item{
  flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:5px;
  background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.14);
  color:#fff; cursor:pointer; padding:10px 12px; border-radius:14px;
  transition:transform .15s ease, background .2s ease;
}
.vc-gift-item:active{ transform:scale(.92); }
.vc-gift-ic{ font-size:22px; line-height:1; }
.vc-gift-name{ font-size:10.5px; opacity:.85; white-space:nowrap; }
.vc-gift-t3{ box-shadow:0 0 12px rgba(255,170,80,.25) inset; }
.vc-gift-t4{ box-shadow:0 0 12px rgba(150,180,255,.3) inset; }
.vc-gift-t5{ box-shadow:0 0 14px rgba(190,150,255,.4) inset; }
.vc-gift-close{
  flex-basis:100%; background:none; border:none; color:#9aa3b8;
  font-size:12px; cursor:pointer; padding:2px;
}

/* ── 全屏礼物特效画布（收成小窗也照放）── */
.vc-fx-canvas{
  position:fixed; inset:0; z-index:9500; pointer-events:none;
}

/* ── 视频来电横幅 ── */
.vc-incoming{
  position:fixed; left:0; right:0; top:0; z-index:9460;
  display:flex; justify-content:center; padding:14px;
  animation:vcIncDown .28s ease;
}
@keyframes vcIncDown{ from{ transform:translateY(-110%);} to{ transform:translateY(0);} }
.vc-incoming-card{
  width:min(420px, 94vw);
  background:rgba(16,20,30,.94); border:1px solid rgba(255,255,255,.14);
  border-radius:18px; padding:14px 16px;
  box-shadow:0 14px 40px rgba(0,0,0,.5);
  backdrop-filter:blur(16px);
}
.vc-incoming-title{ color:#fff; font-weight:600; font-size:14.5px; }
.vc-incoming-say{ color:#b9c2d8; font-size:12.5px; margin-top:5px; }
.vc-incoming-row{ display:flex; gap:10px; margin-top:12px; }
.vc-inc-decline,.vc-inc-accept{
  flex:1; padding:9px 0; border-radius:12px; font-size:13.5px; cursor:pointer; border:none;
}
.vc-inc-decline{ background:rgba(255,255,255,.08); color:#cdd4e4; }
.vc-inc-accept{ background:linear-gradient(135deg,#4cd88a,#2fae6e); color:#fff; font-weight:600; }

/* ── 通话内礼物卡 ── */
.vc-msg-gift{
  background:rgba(80,20,50,.35)!important;
  border:1px solid rgba(255,140,190,.35)!important;
  border-radius:12px; padding:8px 12px!important;
  color:#ffd9e8!important; font-weight:600;
}
.vc-msg-gift-ai{ border-color:rgba(255,170,110,.4)!important; background:rgba(70,35,10,.35)!important; color:#ffe4c8!important; }


/* ════ 新增：屏幕共享 / 相册 / 视频消息按钮 ════ */
.vc-ctl-screen.on, .vc-ctl-album.on, .vc-ctl-vmsg.on {
  background: linear-gradient(135deg, rgba(255, 170, 120, .95), rgba(255, 140, 100, .9));
  color: #fff;
  box-shadow: 0 0 14px rgba(255, 150, 100, .5);
}
.vc-ctl-screen.on .vc-lb, .vc-ctl-vmsg.on .vc-lb { color: #fff; }
/* 录视频消息时的呼吸动画 */
@keyframes vcVmsgPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 90, 90, .6); }
  50%      { box-shadow: 0 0 0 10px rgba(255, 90, 90, 0); }
}
.vc-ctl-vmsg.on { animation: vcVmsgPulse 1.2s ease-in-out infinite; }
